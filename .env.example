# ============================================================
# Course Management System — Environment Variables
# ============================================================
# Copy to .env.local for local development.
# Set the same variables in Vercel → Project → Settings → Environment Variables.
#
# NEVER commit .env.local or expose service-role keys client-side.

# --- Required (Supabase) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Recommended (production) ---
# Used for metadata, OpenGraph, and OAuth redirect URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Optional (production only) ---
# Admin demo seed route (/admin/seed) is disabled in production by default.
# Set to "true" only for staging/demo environments.
# ENABLE_ADMIN_SEED=false

# --- Database migrations ---
# Apply with: npx supabase db push
# Required migration for attendance: 20250525120000_session_attendance_operational.sql
